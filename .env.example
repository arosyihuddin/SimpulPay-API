# GoMerch API — Cloudflare Workers + Postgres via Hyperdrive

# Dev lokal: wrangler dev baca .env otomatis.
# Set connection string buat emulasi Hyperdrive:
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:pass@host:5432/gomerch

# CORS: comma-separated allow-list origin. Kosong = reflect origin (allow semua).
# Production: set ke domain frontend. Contoh: https://app.gomerch.com,http://localhost:5173
CORS_ORIGINS=
