PORT=3000

# Database: sqlite (default) atau postgres.
# DB_DRIVER=postgres => pakai DATABASE_URL di bawah (perlu # migrasi tabel dulu,
#   antara via drizzle-kit push atau SQL CREATE TABLE dari src/db/schema.pg.ts).
DB_DRIVER=sqlite

# Opsional: path database sqlite (default: data/gateway.db)
DATABASE_PATH=./data/gateway.db

# Opsional: koneksi postgres (dipakai saat DB_DRIVER=postgres)
# DATABASE_URL=postgres://user:password@localhost:5432/gomerch

# CORS — deploy terpisah (frontend di host lain). Daftar origin dipisah koma.
# Kosong => allow semua origin (mode dev). Wajib diisi kalau mau credentials.
# CORS_ORIGIN=https://admin.gomerch.com,https://gomerch.com

# Cookie admin session. Deploy terpisah butuh SameSite=None + Secure (HTTPS wajib).
# Default Lax (same-origin, dev pakai http). Jangan pakai None tanpa HTTPS.
# COOKIE_SAMESITE=None
# COOKIE_SECURE=true
