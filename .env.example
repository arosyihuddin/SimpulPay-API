# SimpulPay — Cloudflare Workers + Postgres via Hyperdrive

# Dev lokal: wrangler dev baca .env otomatis.
# Set connection string buat emulasi Hyperdrive:
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:pass@host:5432/simpulpay

# CORS: comma-separated allow-list origin. Kosong = reflect origin (allow semua).
# Production: set ke domain frontend. Contoh: https://app.simpulpay.com,http://localhost:5173
CORS_ORIGINS=

# Log level: trace|debug|info|warn|error|fatal|silent. Default info.
# Dev lokal via .env: LOG_LEVEL=debug
LOG_LEVEL=info

# Login Google (OAuth Authorization Code via backend):
# 1. Buat OAuth client di Google Cloud Console (type Web).
# 2. Authorized redirect URI = GOOGLE_REDIRECT_URI di bawah.
# 3. Isi .env lokal / wrangler secret prod dengan nilai yang sama.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
# FRONTEND_URL = origin frontend buat redirect sukses/gagal OAuth.
FRONTEND_URL=http://localhost:5173
