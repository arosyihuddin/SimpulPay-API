{
  "name": "simpulpay",
  "version": "1.0.0",
  "type": "module",
  "description": "GoPay Merchant Payment Gateway & QRIS Verification (Cloudflare Workers + Neon HTTP)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "bun run seeds/seed.ts"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.1",
    "@neondatabase/serverless": "^1.1.0",
    "bun": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "pino": "^10.3.1",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@types/pngjs": "^6.0.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  }
}
