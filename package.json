{
  "name": "gomerch-api",
  "version": "1.0.0",
  "type": "module",
  "description": "GoPay Merchant Payment Gateway & QRIS Verification API (Cloudflare Workers + Postgres via Hyperdrive)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
